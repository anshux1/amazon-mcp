# NitroStack Configuration
NITROSTACK_APP_MODE=universal
NODE_ENV=development

# Server Transport Configuration
# =============================================================================
# MCP_TRANSPORT_TYPE: stdio | http | dual
# Development defaults to stdio; production defaults explicitly to http when
# this variable is omitted. Set HOST=0.0.0.0 for a container-facing listener.
# CORS is disabled unless an exact comma-separated origin allowlist is set.
# =============================================================================
MCP_TRANSPORT_TYPE=stdio
PORT=3000
HOST=localhost
ENABLE_CORS=false
CORS_ALLOWED_ORIGINS=
# Behind a reverse proxy / NitroStack Cloud: X-Forwarded-Host is only accepted
# when it appears in this allowlist. Any forwarded host is rejected while the
# list is empty. REQUIRE_HTTPS rejects a request whose X-Forwarded-Proto is not
# https, so a TLS-terminating proxy cannot silently downgrade traffic.
TRUSTED_FORWARDED_HOSTS=
REQUIRE_HTTPS=false
# HTTP liveness is /healthz, readiness is /readyz. Readiness fails only when
# persistence is unusable, so a temporary eBay outage cannot restart the app.
# HEALTH_DETAILS=true additionally reports storage mode and applied migrations.
HEALTH_DETAILS=false
MCP_MAX_SESSIONS=1000
MCP_SESSION_TIMEOUT_MS=1800000

# Authentication
# =============================================================================
# Better Auth's JWT plugin uses JWKS and EdDSA by default. Point this at the
# frontend's public JWKS endpoint and keep the issuer/audience identical to the
# Better Auth jwt() configuration.
# =============================================================================
JWT_AUDIENCE=amazon-mcp
JWT_ISSUER=better-auth
JWT_ALGORITHM=EdDSA
JWT_JWKS_URI=http://localhost:3000/api/auth/jwks
JWT_JWKS_CACHE_MAX_AGE_SECONDS=600
JWT_EXPIRES_IN=1h
JWT_MAX_TOKEN_LIFETIME_SECONDS=3600

# HMAC is also supported when the issuer is explicitly configured to mint HS*
# tokens. In that mode, use a long random value and omit JWT_JWKS_URI.
# JWT_SECRET=replace-with-a-32-byte-random-secret
#
# Key rotation (HMAC): set JWT_SECRET to the new value and move the old value to
# JWT_SECRET_PREVIOUS in the same deploy. Both are accepted, so tokens already
# issued stay valid; remove JWT_SECRET_PREVIOUS after JWT_EXPIRES_IN has elapsed.
# The two must differ and both must be non-placeholder 32-byte values.
# JWT_SECRET_PREVIOUS=
#
# Key rotation (JWKS): nothing to do here. Better Auth publishes the new key at
# JWT_JWKS_URI and the guard refreshes once for an unknown kid.

# OAuth 2.1 discovery (optional)
# =============================================================================
# The first-party frontend uses the JWT bridge above and needs no discovery.
# Set OAUTH_ENABLED=true only for external MCP clients that must discover the
# authorization server. Tokens are still verified by the JWT guard, so
# JWT_JWKS_URI / JWT_AUDIENCE / JWT_ISSUER must match the OAuth server.
OAUTH_ENABLED=false
# OAUTH_RESOURCE_URI=https://your-mcp-host.example.com
# OAUTH_AUTHORIZATION_SERVERS=https://auth.example.com
# OAUTH_REQUIRED=false

# Database
# =============================================================================
# DATABASE_URL is required outside development and takes precedence over the
# local file adapter. DATABASE_FILE is for a single local/demo process only.
# Set DATABASE_FILE=:memory: for an ephemeral local/test database.
# =============================================================================
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_FILE=.data/shopping-db.json
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Shopping behaviour
# =============================================================================
# Only DATABASE_URL (Postgres) supports more than one replica: carts, checkout
# quotes, orders, and the eBay quota counter all live there. The file adapter is
# single-process only.
#
# SHOPPING_FULFILLMENT_MODE must be set explicitly outside development and only
# `demo` is implemented: orders are recorded in this database with no payment,
# no inventory reservation, and no eBay fulfilment. `external` refuses to start.
SHOPPING_FULFILLMENT_MODE=demo
SHOPPING_TAX_RATE=0
# How long a checkout quote can be placed. A quote is bound to the cart it was
# priced from, so changing the cart afterwards requires a new quote.
SHOPPING_QUOTE_TTL_SECONDS=600
# shopping://featured-products: a curated id list wins, otherwise this query.
# SHOPPING_FEATURED_ITEM_IDS=
SHOPPING_FEATURED_QUERY=best selling
SHOPPING_FEATURED_LIMIT=10

# eBay Browse + Taxonomy API
# =============================================================================
# Obtain these from https://developer.ebay.com/my/keys.
# EBAY_MOCK=true explicitly enables the deterministic offline demo catalog.
# Outside development, set EBAY_MOCK=false and provide both credentials for
# live access; missing credentials are not silently replaced with the demo.
# =============================================================================
EBAY_MOCK=true
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_SANDBOX=false
# Bounded retries with exponential backoff for transient failures only
# (timeout, dropped connection, 5xx, upstream 429). A 404 or an auth failure is
# returned immediately.
EBAY_MAX_RETRIES=2
EBAY_RETRY_BASE_MS=250
# Keeps a full taxonomy response inside practical client limits.
EBAY_CATEGORY_MAX_DEPTH=4
EBAY_CATEGORY_MAX_NODES=2000
# The daily application budget (4500 requests) is shared by search_products,
# get_product, and get_categories. It is counted per eBay request, not per tool
# call: a cache hit never consumes budget. With DATABASE_URL the counter is
# atomic in Postgres and survives restarts and replicas; otherwise it is
# per-process. If the shared counter is unreachable, `reject` refuses catalog
# calls (protects the budget) and `local` falls back to a per-process count.
EBAY_QUOTA_FALLBACK=reject
