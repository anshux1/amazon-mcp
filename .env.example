# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal
NODE_ENV=development

# Server Transport Configuration
# =============================================================================
# MCP_TRANSPORT_TYPE: stdio | http | dual
# Development defaults to stdio; production defaults to dual.
# =============================================================================
MCP_TRANSPORT_TYPE=stdio
PORT=3000
HOST=localhost
ENABLE_CORS=true

# Authentication
# =============================================================================
# JWT_SECRET must be the same secret used by Better Auth's JWT plugin.
# Use a long random value in every non-development environment.
# Protected cart/order tools always require a valid Bearer token.
# =============================================================================
JWT_SECRET=replace-with-a-32-byte-random-secret
JWT_AUDIENCE=amazon-mcp
JWT_ISSUER=better-auth
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=1h

# Database
# =============================================================================
# Use DATABASE_URL for Postgres/Neon in production. Without it the server uses
# a JSON file store, which is convenient for local demos and smoke tests.
# Set DATABASE_FILE=:memory: for an ephemeral local/test database.
# =============================================================================
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_FILE=.data/shopping-db.json
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# eBay Browse + Taxonomy API
# =============================================================================
# Obtain these from https://developer.ebay.com/my/keys.
# If credentials are omitted, EBAY_MOCK=true is used for an offline demo.
# =============================================================================
EBAY_MOCK=true
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_SANDBOX=false
